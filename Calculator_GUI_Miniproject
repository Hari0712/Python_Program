import tkinter as tk

root = tk.Tk()
root.title("Calculator")

root.attributes('-fullscreen', True)
root.config(bg="#f0f0f0")

root.bind("<Escape>", lambda event: root.attributes('-fullscreen', False))

expression = ""

def press(num):
    global expression
    expression = expression + str(num)
    equation.set(expression)

def evaluate():
    try:
        global expression
        total = str(eval(expression))
        equation.set(total)
        expression = total
    except:
        equation.set("Error")
        expression = ""

def clear():
    global expression
    expression = ""
    equation.set("")

equation = tk.StringVar()

main_frame = tk.Frame(root, bg="#f0f0f0")
main_frame.pack(expand=True)

display = tk.Entry(main_frame, textvariable=equation, font=("Arial", 28), justify="right", bd=5)
display.grid(row=0, column=0, columnspan=4, ipadx=8, ipady=15, padx=10, pady=20)

btn1 = tk.Button(main_frame, text='1', fg='black', bg='white', width=8, height=3, font=("Arial", 14), command=lambda: press(1))
btn1.grid(row=1, column=0, padx=5, pady=5)

btn2 = tk.Button(main_frame, text='2', fg='black', bg='white', width=8, height=3, font=("Arial", 14), command=lambda: press(2))
btn2.grid(row=1, column=1, padx=5, pady=5)

btn3 = tk.Button(main_frame, text='3', fg='black', bg='white', width=8, height=3, font=("Arial", 14), command=lambda: press(3))
btn3.grid(row=1, column=2, padx=5, pady=5)

plus = tk.Button(main_frame, text='+', fg='black', bg='lightblue', width=8, height=3, font=("Arial", 14), command=lambda: press("+"))
plus.grid(row=1, column=3, padx=5, pady=5)

btn4 = tk.Button(main_frame, text='4', fg='black', bg='white', width=8, height=3, font=("Arial", 14), command=lambda: press(4))
btn4.grid(row=2, column=0, padx=5, pady=5)

btn5 = tk.Button(main_frame, text='5', fg='black', bg='white', width=8, height=3, font=("Arial", 14), command=lambda: press(5))
btn5.grid(row=2, column=1, padx=5, pady=5)

btn6 = tk.Button(main_frame, text='6', fg='black', bg='white', width=8, height=3, font=("Arial", 14), command=lambda: press(6))
btn6.grid(row=2, column=2, padx=5, pady=5)

minus = tk.Button(main_frame, text='-', fg='black', bg='lightblue', width=8, height=3, font=("Arial", 14), command=lambda: press("-"))
minus.grid(row=2, column=3, padx=5, pady=5)

btn7 = tk.Button(main_frame, text='7', fg='black', bg='white', width=8, height=3, font=("Arial", 14), command=lambda: press(7))
btn7.grid(row=3, column=0, padx=5, pady=5)

btn8 = tk.Button(main_frame, text='8', fg='black', bg='white', width=8, height=3, font=("Arial", 14), command=lambda: press(8))
btn8.grid(row=3, column=1, padx=5, pady=5)

btn9 = tk.Button(main_frame, text='9', fg='black', bg='white', width=8, height=3, font=("Arial", 14), command=lambda: press(9))
btn9.grid(row=3, column=2, padx=5, pady=5)

multiply = tk.Button(main_frame, text='*', fg='black', bg='lightblue', width=8, height=3, font=("Arial", 14), command=lambda: press("*"))
multiply.grid(row=3, column=3, padx=5, pady=5)

btn0 = tk.Button(main_frame, text='0', fg='black', bg='white', width=8, height=3, font=("Arial", 14), command=lambda: press(0))
btn0.grid(row=4, column=0, padx=5, pady=5)

decimal = tk.Button(main_frame, text='.', fg='black', bg='white', width=8, height=3, font=("Arial", 14), command=lambda: press('.'))
decimal.grid(row=4, column=1, padx=5, pady=5)

equal = tk.Button(main_frame, text='=', fg='black', bg='lightgreen', width=8, height=3, font=("Arial", 14), command=evaluate)
equal.grid(row=4, column=2, padx=5, pady=5)

divide = tk.Button(main_frame, text='/', fg='black', bg='lightblue', width=8, height=3, font=("Arial", 14), command=lambda: press("/"))
divide.grid(row=4, column=3, padx=5, pady=5)

clear_btn = tk.Button(main_frame, text='C', fg='black', bg='lightcoral', width=35, height=2, font=("Arial", 14), command=clear)
clear_btn.grid(row=5, column=0, columnspan=4, padx=5, pady=5)


root.mainloop()
