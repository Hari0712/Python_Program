import tkinter as tk
from tkinter import messagebox

root = tk.Tk()
root.title("Student Marks Entry Form")
root.attributes('-fullscreen', True)
root.config(bg="#f4f6f9")

root.bind("<Escape>", lambda event: root.attributes('-fullscreen', False))

main_frame = tk.Frame(root, bg="#f4f6f9")
main_frame.pack(expand=True)

title_label = tk.Label(
    main_frame, 
    text="Student Marks Evaluation", 
    font=("Arial", 22, "bold"), 
    bg="#f4f6f9", 
    fg="#2c3e50"
)
title_label.grid(row=0, column=0, columnspan=2, pady=15)

form_frame = tk.Frame(main_frame, bg="#ffffff", bd=2, relief=tk.GROOVE)
form_frame.grid(row=1, column=0, columnspan=2, padx=20, pady=10)

tk.Label(form_frame, text="Student Name:", font=("Arial", 12), bg="#ffffff", fg="#34495e").grid(row=0, column=0, sticky="w", padx=20, pady=8)
name_entry = tk.Entry(form_frame, font=("Arial", 12), width=20)
name_entry.grid(row=0, column=1, padx=20, pady=8)

tk.Label(form_frame, text="Register Number:", font=("Arial", 12), bg="#ffffff", fg="#34495e").grid(row=1, column=0, sticky="w", padx=20, pady=8)
reg_entry = tk.Entry(form_frame, font=("Arial", 12), width=20)
reg_entry.grid(row=1, column=1, padx=20, pady=8)

tk.Label(form_frame, text="Tamil Marks (0-100):", font=("Arial", 12), bg="#ffffff", fg="#34495e").grid(row=2, column=0, sticky="w", padx=20, pady=8)
tamil_entry = tk.Entry(form_frame, font=("Arial", 12), width=20)
tamil_entry.grid(row=2, column=1, padx=20, pady=8)

tk.Label(form_frame, text="English Marks (0-100):", font=("Arial", 12), bg="#ffffff", fg="#34495e").grid(row=3, column=0, sticky="w", padx=20, pady=8)
english_entry = tk.Entry(form_frame, font=("Arial", 12), width=20)
english_entry.grid(row=3, column=1, padx=20, pady=8)

tk.Label(form_frame, text="Maths Marks (0-100):", font=("Arial", 12), bg="#ffffff", fg="#34495e").grid(row=4, column=0, sticky="w", padx=20, pady=8)
maths_entry = tk.Entry(form_frame, font=("Arial", 12), width=20)
maths_entry.grid(row=4, column=1, padx=20, pady=8)

tk.Label(form_frame, text="Science Marks (0-100):", font=("Arial", 12), bg="#ffffff", fg="#34495e").grid(row=5, column=0, sticky="w", padx=20, pady=8)
science_entry = tk.Entry(form_frame, font=("Arial", 12), width=20)
science_entry.grid(row=5, column=1, padx=20, pady=8)

tk.Label(form_frame, text="Social Science Marks (0-100):", font=("Arial", 12), bg="#ffffff", fg="#34495e").grid(row=6, column=0, sticky="w", padx=20, pady=8)
social_entry = tk.Entry(form_frame, font=("Arial", 12), width=20)
social_entry.grid(row=6, column=1, padx=20, pady=8)

result_text = tk.StringVar()
result_text.set("Total: --  |  Average: --  |  Status: --")

def calculate_marks():
    try:
        name = name_entry.get().strip()
        reg_no = reg_entry.get().strip()

        if not name or not reg_no:
            messagebox.showerror("Error", "Please fill in Name and Register Number.")
            return

        t = float(tamil_entry.get())
        e = float(english_entry.get())
        m = float(maths_entry.get())
        s = float(science_entry.get())
        soc = float(social_entry.get())

        if not (0 <= t <= 100 and 0 <= e <= 100 and 0 <= m <= 100 and 0 <= s <= 100 and 0 <= soc <= 100):
            messagebox.showerror("Error", "Marks must be between 0 and 100.")
            return

        total = t + e + m + s + soc
        average = total / 5

        if t >= 35 and e >= 35 and m >= 35 and s >= 35 and soc >= 35:
            status = "Pass"
            status_color = "#27ae60"
        else:
            status = "Fail"
            status_color = "#e74c3c"

        result_text.set(f"Total: {total:.1f}/500  |  Avg: {average:.2f}%  |  Status: {status}")
        result_label.config(fg=status_color)

    except ValueError:
        messagebox.showerror("Error", "Please enter valid numerical values for marks.")

def reset_form():
    name_entry.delete(0, tk.END)
    reg_entry.delete(0, tk.END)
    tamil_entry.delete(0, tk.END)
    english_entry.delete(0, tk.END)
    maths_entry.delete(0, tk.END)
    science_entry.delete(0, tk.END)
    social_entry.delete(0, tk.END)
    result_text.set("Total: --  |  Average: --  |  Status: --")
    result_label.config(fg="#2c3e50")

btn_frame = tk.Frame(main_frame, bg="#f4f6f9")
btn_frame.grid(row=2, column=0, columnspan=2, pady=15)

calc_btn = tk.Button(
    btn_frame, 
    text="Calculate", 
    font=("Arial", 12, "bold"), 
    bg="#27ae60", 
    fg="#ffffff", 
    width=12, 
    command=calculate_marks
)
calc_btn.grid(row=0, column=0, padx=10)

reset_btn = tk.Button(
    btn_frame, 
    text="Reset", 
    font=("Arial", 12, "bold"), 
    bg="#e74c3c", 
    fg="#ffffff", 
    width=12, 
    command=reset_form
)
reset_btn.grid(row=0, column=1, padx=10)

result_frame = tk.Frame(main_frame, bg="#ffffff", bd=2, relief=tk.GROOVE)
result_frame.grid(row=3, column=0, columnspan=2, padx=20, pady=10, sticky="ew")

result_label = tk.Label(
    result_frame, 
    textvariable=result_text, 
    font=("Arial", 12, "bold"), 
    bg="#ffffff", 
    fg="#2c3e50"
)
result_label.pack(pady=12)

root.mainloop()
