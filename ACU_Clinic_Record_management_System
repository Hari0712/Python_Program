            p_id = int(self.pIdIn.get().strip())
            new_pain = int(self.newPainIn.get().strip())
            new_dx = self.newDxIn.get().strip()

            if not (0 <= new_pain <= 10):
                messagebox.showerror("Error", "Pain level must be 0 to 10!")
                return

            self.dbFun()
            self.cur.execute("SELECT acupoints_prescribed FROM acupuncture_full_intake WHERE id=%s", (p_id,))
            val = self.cur.fetchone()
            if not val:
                self.con.close()
                messagebox.showerror("Error", f"Patient ID {p_id} not found!")
                return

            updated_dx = new_dx if new_dx else val[0]
            self.cur.execute(
                "UPDATE acupuncture_full_intake SET pain_level=%s, acupoints_prescribed=%s WHERE id=%s",
                (new_pain, updated_dx, p_id),
            )
            self.con.commit()
            self.con.close()

            self.painFrame.destroy()
            self.showAllPatients()
            messagebox.showinfo("Updated", f"Pain & Acupoints updated for Patient {p_id}")
        except Exception as e:
            messagebox.showerror("Error", f"Error: {e}")

    def disFun(self):
        id_str = self.pIdIn.get().strip()
        if not id_str:
            messagebox.showerror("Error", "Enter Patient ID first!")
            return
        try:
            p_id = int(id_str)
            self.dbFun()
            self.cur.execute("DELETE FROM acupuncture_full_intake WHERE id=%s", (p_id,))
            affected = self.cur.rowcount
            self.con.commit()
            self.con.close()

            if affected > 0:
                self.showAllPatients()
                self.pIdIn.delete(0, tk.END)
                messagebox.showinfo("Deleted", f"Patient {p_id} record removed.")
            else:
                messagebox.showinfo("Not Found", f"No patient found with ID {p_id}")
        except Exception as e:
            messagebox.showerror("Error", f"Error: {e}")


