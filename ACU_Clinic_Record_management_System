    def insertFun(self):
        id_str = self.idIn.get().strip()
        name = self.nameIn.get().strip()
        phone = self.phoneIn.get().strip()
        pain_str = self.painIn.get().strip() or "0"
        stress_str = self.stressLvlIn.get().strip() or "0"
        acupoints = self.dxIn.get().strip()

        if not (id_str and name and phone):
            messagebox.showerror("Missing Required Fields", "Patient ID, Full Name, and Phone are required!")
            return

        try:
            p_id = int(id_str)
            pain_lvl = int(pain_str)
            stress_lvl = int(stress_str)

            if not (0 <= pain_lvl <= 10 and 0 <= stress_lvl <= 10):
                messagebox.showerror("Invalid Scale", "Pain Level and Stress Level must be between 0 and 10!")
                return

            issues_list = []
            for idx, (ent, cmb) in enumerate(zip(self.issueEntries, self.sevCombos), 1):
                if ent.get().strip():
                    issues_list.append(f"{idx}) {ent.get().strip()} [{cmb.get()}]")
            main_issues_str = "; ".join(issues_list) if issues_list else "General Consultation"

            prec_list = [k for k, v in self.precVars.items() if v.get()]
            if self.skinLocIn.get().strip():
                prec_list.append(f"Skin Loc: {self.skinLocIn.get().strip()}")
            precautions_str = ", ".join(prec_list) if prec_list else "None"

            med_history_str = (
                f"Childhood: {self.childIn.get().strip()} | Hospital: {self.hospStayIn.get().strip()} | "
                f"Immunizations: {self.immIn.get().strip()} | Surgeries: {self.surgIn.get().strip()}"
            )

            organ_checked = [k for k, v in self.organVars.items() if v.get()]
            organ_str = ", ".join(organ_checked) if organ_checked else "None reported"

            pms_checked = [k for k, v in self.pmsVars.items() if v.get()]
            womens_str = (
                f"Cycle/LMP: {self.cycleIn.get().strip()} | Infert/Kids: {self.infertIn.get().strip()} | "
                f"Age/Days: {self.mensesAgeIn.get().strip()} | Preg/Misc/Ab: {self.pregHistIn.get().strip()} | "
                f"Meno/BC: {self.menoBcIn.get().strip()} | Flow/Clots: {self.bleedIn.get().strip()} | "
                f"PMS: {', '.join(pms_checked)}"
            )
            chart_str = (
                f"Color: {self.mColorIn.get().strip()} | Flow: {self.mFlowIn.get().strip()} | "
                f"Pain: {self.mPainIn.get().strip()} | Clots/GI: {self.mClotIn.get().strip()}"
            )
            men_checked = [k for k, v in self.menVars.items() if v.get()]
            mens_str = ", ".join(men_checked) if men_checked else "N/A"

            pain_chars = [k for k, v in self.painCharVars.items() if v.get()]
            pulse_str = " | ".join(
                [f"{pos}: {ent.get().strip()}" for pos, ent in self.pulseEntries.items() if ent.get().strip()]
            )

            self.dbFun()
            query = """REPLACE INTO acupuncture_full_intake VALUES (
                %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s,
                %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s, %s
            )"""
            values = (
                p_id,
                name,
                self.dobIn.get().strip(),
                self.genderCombo.get(),
                phone,
                self.addrIn.get().strip(),
                self.physIn.get().strip(),
                self.emergIn.get().strip(),
                self.refCombo.get().strip(),
                main_issues_str,
                self.impairIn.get().strip(),
                self.otherTreatIn.get().strip(),
                self.durIn.get().strip(),
                self.betterWorseIn.get().strip(),
                self.medDxIn.get().strip(),
                self.medsIn.get().strip(),
                self.allergyIn.get().strip(),
                precautions_str,
                med_history_str,
                f"{self.emoIn.get().strip()} / {self.stressHoldIn.get().strip()}",
                stress_lvl,
                self.sleepIn.get().strip(),
                "",
                f"{self.coffeeSmokeIn.get().strip()} | {self.alcDrugIn.get().strip()}",
                organ_str,
                f"Urine: {self.urineIn.get().strip()} | Eyes: {self.eyesIn.get().strip()} | Libido: {self.libidoIn.get().strip()}",
                womens_str,
                chart_str,
                mens_str,
                pain_lvl,
                self.painLocIn.get().strip(),
                self.painDurIn.get().strip(),
                ", ".join(pain_chars),
                f"Lessens: {self.painLessIn.get().strip()} | Worsens: {self.painWorseIn.get().strip()}",
                f"{self.painInjIn.get().strip()} | Prior: {self.priorPainTxIn.get().strip()}",
                "",
                self.tongueDxIn.get().strip(),
                pulse_str,
                acupoints,
            )

            self.cur.execute(query, values)
            self.con.commit()
            self.con.close()

            self.clearForm()
            self.showAllPatients()
            messagebox.showinfo("Saved", f"Full Acupuncture Intake saved for {name} (ID: {p_id})!")

        except ValueError:
            messagebox.showerror("Input Error", "ID, Pain Level, and Stress Level must be numbers!")
        except Exception as e:
            messagebox.showerror("Database Error", f"Error: {e}")

